{
  "expo": {
    "name": "Mobile-app",
    "slug": "Mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/KampusLF-app-icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/KampusLF-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#85d5fb",
        "foregroundImage": "./assets/images/KampusLF-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.cruise4you.KampusLF"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#85d5fb",
          "image": "./assets/images/KampusLF-app-icon.png",
          "dark": {
            "image": "./assets/images/KampusLF-app-icon.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 240
        }
      ],
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "dark"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30bcf3d2-ed77-45e1-a763-167c54b555c1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/30bcf3d2-ed77-45e1-a763-167c54b555c1"
    }
  }
}
